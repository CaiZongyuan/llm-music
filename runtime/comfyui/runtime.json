      "license_source": "https://github.com/Comfy-Org/ComfyUI/blob/7a5dad695fe1cae25efcb2550530fb20ef68da3d/LICENSE"
    },
    "plugin": {
      "repository": "https://github.com/pytraveler/YuE2-ComfyUI.git",
      "revision": "fc78df9dfb214f396aa281f5b03519cefff5b00a",
      "code_license": "Apache-2.0; vendored inference code retains its upstream license",
      "license_source": "https://github.com/pytraveler/YuE2-ComfyUI/blob/fc78df9dfb214f396aa281f5b03519cefff5b00a/NOTICE.md"
    }
  },
  "required_nodes": ["YuE2GenerateSong", "YuE2Options", "YuE2Transcribe"],

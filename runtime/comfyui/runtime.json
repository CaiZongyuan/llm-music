{
  "schema_version": 1,
  "python": "3.12.13",
  "torch": "2.10.0+cu130",
  "torch_cuda": "13.0",
  "gpu_name": "NVIDIA GeForce RTX 3070 Ti Laptop GPU",
  "min_vram_mib": 8192,
  "min_free_disk_bytes": 10737418240,
  "port": 8188,
  "probe_timeout_seconds": 120,
